# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any vision-capable Gemini model your key can use. Run `python -m playbook check`
# to see which models work for your key right now.
GEMINI_MODEL=gemini-3.5-flash

# Tried in order if the model above is unavailable or out of free quota.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-flash-lite-latest

# Free-tier limits differ by project (check AI Studio). Keep this conservative.
RPM_LIMIT=5

# Steps whose calibrated confidence is below this are flagged for human review.
CONFIDENCE_THRESHOLD=0.70

# Optional tuning
# CAPTURE_FPS=5
# HEARTBEAT_S=10
# WINDOW_SIZE=10   # keyframes per request; higher = fewer requests (free daily quotas are small)
# MASK_TYPED_TEXT=false
# MONITOR=1
# SESSIONS_DIR=./sessions
