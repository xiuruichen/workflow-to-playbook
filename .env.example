# Every setting has a default; this file is optional.

# --- Where analysis runs ---
# local (default): a vision model on this computer (llama-server or Ollama). Run `python -m playbook setup-local` once.
# gemini: Google's API. Screenshots are uploaded, so this also needs ALLOW_CLOUD=true.
PROVIDER=local
ALLOW_CLOUD=false

# Slow or easily overloaded computer: smallest model, half the CPU threads (max 6), below-normal priority,
# no zoom crops (each image costs ~1 min of CPU), hardware-only video encoding. Set before `setup-local`.
# LOW_POWER=false
# MAX_THREADS=0
# Local server: llama (llama.cpp's llama-server; ~2x faster on a CPU, runs only during analysis),
# ollama, or auto (llama in low-power mode on Windows).
# LOCAL_RUNTIME=auto
# LLAMA_SERVER=            # your own llama-server binary (default: the one setup-local downloads)
# LLAMA_PORT=18080
# IMAGE_MAX_TOKENS=448

# --- Local model ---
# auto = what setup-local configured, or the largest Qwen3-VL that fits this computer's RAM/VRAM.
# LOCAL_MODEL=auto
# LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# USE_OCR=true           # local OCR of on-screen text (helps small models)
# SEND_CROPS=true        # zoomed crop around each click (helps small models)

# --- Storage and archives ---
# Sessions default to a per-user local folder (%LOCALAPPDATA%\WorkflowPlaybook on Windows),
# never inside OneDrive/Dropbox/iCloud/Google Drive unless ALLOW_SYNCED_DIR=true.
# SESSIONS_DIR=
# AUTO_COMPACT=idle:2    # archive (compress + encrypt) sessions untouched for 2 days; or after_analysis / off
# ARCHIVE_VIDEO=compress # compress (AV1) / original / drop
# ARCHIVE_PASSPHRASE=    # only if there is no OS keyring to hold the archive key

# --- Review ---
# Steps whose calibrated confidence is below this are flagged for human review.
CONFIDENCE_THRESHOLD=0.70

# --- Capture ---
# CAPTURE_FPS=5
# HEARTBEAT_S=10
# WINDOW_SIZE=0                # keyframes per request; 0 = auto (by model size)
# MASK_TYPED_TEXT=false
# CAPTURE_WINDOW_TITLES=true   # record the focused app/window title with each event (Windows)
# CAPTURE_UI_ELEMENTS=true     # record the clicked / typed-into UI element (Windows UI Automation)
# MONITOR=1

# --- Gemini (only with PROVIDER=gemini and ALLOW_CLOUD=true) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-flash-lite-latest
# RPM_LIMIT=5
